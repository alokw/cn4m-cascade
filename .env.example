# cn4m cascade — production configuration.
#
# Copy to .env and fill in. `.env` is gitignored; this file is committed, so
# never put a real key or password in it.
#
#     cp .env.example .env
#
# Only ENCRYPTION_KEY is required. Everything else has a working default.


# ── Required ────────────────────────────────────────────────────────────────

# Encrypts every stored target password. Generate one with:
#
#     openssl rand -base64 32
#
# Treat it like the passwords it protects, and **back it up with ./data**:
# the database is unreadable without it, and there is no recovery path. The
# server refuses to start if this is missing or shorter than 16 characters,
# rather than coming up unable to store a credential.
ENCRYPTION_KEY=replace-me-openssl-rand-base64-32


# ── Optional ────────────────────────────────────────────────────────────────

# Seeds the admin password on first run, so a container can come up already
# configured. It never overwrites an existing password — an env var left in a
# file must not silently reset the credential on every restart.
#
# Leave it unset to set the password through the first-run screen instead. An
# empty value means "not configured", not "no password": choosing to have no
# password has to be a deliberate act, and is only reachable through that
# screen. See the README on running without one.
#CN4M_CASCADE_ADMIN_PASSWORD=

# The timezone cron schedules are read in. Unset means UTC, which is usually
# not what "0 2 * * *" was meant to mean. The job editor shows the resolved
# next run in both this zone and your browser's, so a mismatch is visible.
TZ=UTC

# Where this reports its status in the cn4m suite.
#
# LEAVE THIS COMMENTED OUT unless cn4m is on another machine: each deployment
# already defaults to the right thing, and hardcoding one breaks the other.
#
#   - In Docker, compose defaults it to `host.docker.internal`, because inside
#     a bridge-networked container `localhost` is the container itself.
#   - Running natively, the binary defaults it to `localhost` — there is no
#     container, so the ordinary name is the correct one.
#
# Set it explicitly only to point somewhere else, or to "off" when this install
# is not part of a cn4m suite.
#CN4M_CASCADE_STATUS_URL=http://localhost:2640/suite/status
#CN4M_CASCADE_STATUS_URL=http://host.docker.internal:2640/suite/status
#CN4M_CASCADE_STATUS_URL=off

# Discord notifications. A one-line message when a run finishes, with an emoji
# for the outcome:
#
#     🔄 ✅ Sync complete — 6 succeeded, 0 failed, 1 skipped
#     🔄 ❌ Sync failed — 0 succeeded, 1 failed, 0 skipped
#
# Create one in Discord under Server Settings → Integrations → Webhooks.
#
# TREAT THE URL AS A SECRET: anyone holding it can post to that channel. It is
# stored in the database like any other webhook, and never written to a log.
#
# Only seeds a FRESH database, and never overwrites: after the first run the
# row belongs to the Webhooks & API tab, where it can be edited or removed.
# Subscribed to run_completed and run_failed only — progress would post a line
# every interval, for the length of every run.
#CN4M_CASCADE_DISCORD_WEBHOOK=https://discord.com/api/webhooks/<id>/<token>

# ── Docker only ─────────────────────────────────────────────────────────────
#
# A folder on this machine to sync to or from, bind-mounted into the container.
# IGNORED by a native install: without a container there is nothing to map, so
# a local target is simply given a real path (M:\projects\repo, /srv/media).
#
# Inside the container it appears as /mnt/local, and /mnt/local is what you type
# when creating a local target there — not the host path, which the container
# cannot see.
#
# Defaults to ~/cn4m, or %USERPROFILE%\cn4m on Windows.
# On Windows use forward slashes: C:/Users/you/cn4m
#CN4M_CASCADE_LOCAL_DIR=
#
# Examples — an alternative folder to sync from, on another drive:
#CN4M_CASCADE_LOCAL_DIR=D:/Media/Projects
#CN4M_CASCADE_LOCAL_DIR=C:/Users/you/Documents
#
# It still appears as /mnt/local whatever you point it at. For a SECOND folder
# alongside it, add a bind mount to docker-compose.yml — there is a commented
# example there.

# The host port the web UI is published on. The container always listens on
# 2649 internally; this only changes the outside. The test harness publishes
# 12649, so these two do not collide.
#LISTEN_PORT=2649
