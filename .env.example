# cn4m cascade — production configuration.
#
# Copy to .env and fill in. `.env` is gitignored; this file is committed, so
# never put a real key or password in it.
#
#     cp .env.example .env
#
# Only ENCRYPTION_KEY is required. Everything else has a working default.


# ── Required ────────────────────────────────────────────────────────────────

# Encrypts every stored target password. Generate one with:
#
#     openssl rand -base64 32
#
# Treat it like the passwords it protects, and **back it up with ./data**:
# the database is unreadable without it, and there is no recovery path. The
# server refuses to start if this is missing or shorter than 16 characters,
# rather than coming up unable to store a credential.
ENCRYPTION_KEY=replace-me-openssl-rand-base64-32


# ── Optional ────────────────────────────────────────────────────────────────

# Seeds the admin password on first run, so a container can come up already
# configured. It never overwrites an existing password — an env var left in a
# file must not silently reset the credential on every restart.
#
# Leave it unset to set the password through the first-run screen instead. An
# empty value means "not configured", not "no password": choosing to have no
# password has to be a deliberate act, and is only reachable through that
# screen. See the README on running without one.
#CN4M_CASCADE_ADMIN_PASSWORD=

# The timezone cron schedules are read in. Unset means UTC, which is usually
# not what "0 2 * * *" was meant to mean. The job editor shows the resolved
# next run in both this zone and your browser's, so a mismatch is visible.
TZ=UTC

# Where this reports its status in the cn4m suite. `host.docker.internal`
# rather than `localhost`, because inside a bridge-networked container
# localhost is the container itself. Set to "off" if this install is not part
# of a cn4m suite.
CN4M_CASCADE_STATUS_URL=http://host.docker.internal:2640/suite/status

# A folder on this machine to sync to or from. It appears inside the container
# as /mnt/local, which is the path you type when creating a local target —
# the same string on every platform.
#
# Defaults to ~/cn4m, or %USERPROFILE%\cn4m on Windows.
# On Windows use forward slashes: C:/Users/you/cn4m
#CN4M_CASCADE_LOCAL_DIR=
#
# Examples — an alternative folder to sync from, on another drive:
#CN4M_CASCADE_LOCAL_DIR=D:/Media/Projects
#CN4M_CASCADE_LOCAL_DIR=C:/Users/you/Documents
#
# This still appears as /mnt/local inside the container, so /mnt/local stays
# the path you type into the UI. For a SECOND folder alongside it, add a bind
# mount to docker-compose.yml instead — there is a commented example there.

# The host port the web UI is published on. The container always listens on
# 2649 internally; this only changes the outside. The test harness publishes
# 12649, so these two do not collide.
#LISTEN_PORT=2649
