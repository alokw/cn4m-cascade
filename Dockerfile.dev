# Development / test container. The host may be macOS, where mount.cifs does
# not exist, so every build, lint and test runs in here (PROGRESS.md B-1/B-2).
FROM golang:1.25-bookworm

RUN apt-get update \
 && apt-get install -y --no-install-recommends cifs-utils procps iproute2 iptables ca-certificates curl jq \
 && rm -rf /var/lib/apt/lists/*

# Prebuilt binary rather than `go install`: building the linter from source
# ties its version to the container's Go toolchain.
RUN curl -sSfL https://raw.githubusercontent.com/golangci/golangci-lint/HEAD/install.sh \
      | sh -s -- -b /usr/local/bin latest \
 && golangci-lint --version

# Node builds the SPA (SPEC.md §9, §10). It is a build-time dependency only:
# the production image embeds the compiled assets in the Go binary and ships no
# JavaScript toolchain. Pinned to a major version rather than "latest" so a
# frontend build is reproducible.
COPY --from=node:22-bookworm /usr/local/bin/node /usr/local/bin/node
COPY --from=node:22-bookworm /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && node --version && npm --version

ENV CGO_ENABLED=0
WORKDIR /src
CMD ["bash"]
